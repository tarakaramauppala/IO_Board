# Copy to secrets/station.env (gitignored) and fill in. Never commit the real file.
# Use a DEDICATED, LEAST-PRIVILEGE ThingsBoard user per project — never an admin token.

# Cloud (ThingsBoard / VX Olympus) — only if the product reports telemetry.
VX_TB_BASE_URL=https://your-thingsboard-host
VX_TB_USERNAME=readonly-test-user@example.com
VX_TB_PASSWORD=

# Device under test — identity + LoRaWAN keys. Loaded by config.py (_load_env) and written into the
# 0xFC000 settings block on flash. Get these from your device provisioning / device_map; never commit
# the real values. (VDUI/DevEUI = 16 hex, AppEUI = 16 hex, AppKey = 32 hex.)
DEVICE_UUID=FFFF0000FFFF0000
DEVICE_APP_EUI=0000000000000000
DEVICE_APP_KEY=00000000000000000000000000000000
TB_DEVICE_ID=

# Bench instrument COM ports on your machine (from Device Manager). Blank = that instrument is absent
# (the station then degrades: no PSU control / no meter grading / manual injection).
PSU_PORT=
METER_PORT=
METER_BAUD=115200
WAVESHARE_PORT=

# Optional bearer token for this product's own dashboard, if it needs auth — any
# long random string. (The dashboard is bespoke; /build-dashboard decides if it uses this.)
DASHBOARD_TOKEN=
